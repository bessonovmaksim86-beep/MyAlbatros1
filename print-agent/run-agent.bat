@echo off
chcp 65001 >nul
REM Запуск агента печати этикеток.
REM Запускать от имени пользователя, под которым работает BarTender.

REM 1. Ищем java: сначала в PATH, потом в стандартных местах.
where /q java
if %errorlevel% neq 0 (
    echo Java не найдена в PATH.
    echo Установите JRE 11+ или укажите JAVA_HOME в системных переменных.
    pause
    exit /b 1
)

echo ========================================
echo Агент печати этикеток
echo ========================================
echo Порт: 7788
echo Слушает: 127.0.0.1 (недоступен из сети)
echo ========================================
echo.

REM Запуск в отдельном окне (не detach) — чтобы видеть ошибки.
java PrintAgent

echo.
echo Агент остановлен. Нажмите любую клавишу для выхода.
pause >nul
